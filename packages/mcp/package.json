{
    "name": "@nowline/mcp",
    "mcpName": "io.nowline/nowline",
    "version": "0.9.0",
    "description": "Nowline MCP server — lets AI agents create, edit, and render your roadmaps.",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22",
        "pnpm": ">=12.6.0"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "nowline-mcp": "./dist/index.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./http": {
            "types": "./dist/http.d.ts",
            "import": "./dist/http.js"
        }
    },
    "files": [
        "dist/",
        "src/"
    ],
    "scripts": {
        "prebuild": "node scripts/bundle-resources.mjs && node scripts/bundle-ui.mjs",
        "build": "tsc -b tsconfig.json",
        "watch": "tsc -b tsconfig.json --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@modelcontextprotocol/ext-apps": "^2.0.3",
        "@modelcontextprotocol/node": "^2.1.1",
        "@modelcontextprotocol/server": "^2.3.1",
        "@nowline/browser": "workspace:*",
        "@nowline/config": "workspace:*",
        "@nowline/core": "workspace:*",
        "@nowline/export": "workspace:*",
        "@nowline/export-core": "workspace:*",
        "@nowline/layout": "workspace:*",
        "@nowline/preview": "workspace:*",
        "@nowline/preview-shell": "workspace:*",
        "@nowline/share-link": "workspace:*",
        "@resvg/resvg-wasm": "^2.6.2",
        "langium": "~4.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "^2.3.1",
        "@modelcontextprotocol/inspector": "2.12.0",
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "vitest": "^5.0.5"
    }
}
