{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "platformAutomerge": true,
    "extends": [
        "config:recommended",
        "group:monorepos",
        "group:recommended",
        ":semanticCommits",
        ":dependencyDashboard"
    ],
    "timezone": "UTC",
    "schedule": ["before 09:00 on Friday"],
    "labels": ["dependencies", "automated", "no-changelog"],
    "assignees": ["copilot-swe-agent[bot]"],
    "reviewersFromCodeOwners": true,
    "prConcurrentLimit": 10,
    "prHourlyLimit": 0,
    "rebaseWhen": "behind-base-branch",
    "rangeStrategy": "bump",
    "minimumReleaseAge": "14 days",
    "packageRules": [
        {
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "all minor and patch updates",
            "groupSlug": "minor-patch",
            "commitMessagePrefix": "chore(deps):",
            "automerge": true
        },
        {
            "matchUpdateTypes": ["major"],
            "addLabels": ["major"],
            "commitMessagePrefix": "feat(deps)!:",
            "minimumReleaseAge": "30 days"
        },
        {
            "matchPackageNames": ["node"],
            "matchUpdateTypes": ["major"],
            "enabled": false,
            "description": "Node majors (the .nvmrc and setup-node major, and the consumer floor) are policy changes governed by nowline/CONTRIBUTING.md § Toolchain & Supported Versions, not Renovate. Minor and patch bumps of the .nvmrc pin stay enabled."
        },
        {
            "matchPackageNames": ["node"],
            "matchDepTypes": ["engines"],
            "enabled": false,
            "description": "engines.node is the consumer floor; tightening it is a breaking change (nowline/CONTRIBUTING.md § Toolchain & Supported Versions), never a Renovate bump."
        },
        {
            "matchPackageNames": ["@types/vscode"],
            "enabled": false,
            "description": "Floor tracks Cursor's embedded VS Code engine + 30-day grace; driven by .github/workflows/vscode-extension-engine-bump.yml (weekly, opens an issue when the floor should advance) + editor-release-monitor.yml (daily, writes cursor-release-history.json), not Renovate. Renovate would otherwise bump @types/vscode past engines.vscode and break vsce package (see v0.3.0 release-run #26337633859)."
        },
        {
            "matchPackageNames": ["@nowline/**"],
            "minimumReleaseAge": "0 days",
            "description": "Consumers should pick up a nowline release the week it ships (lockstep with the CLI), so @nowline packages skip the release-age wait. Last on purpose: it must override the major rule's 30 days."
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Track Bun version pinned in workflow inputs (oven-sh/setup-bun)",
            "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
            "matchStrings": ["bun-version:\\s*['\"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)['\"]?"],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "oven-sh/bun",
            "extractVersionTemplate": "^bun-v(?<version>.+)$"
        },
        {
            "customType": "regex",
            "description": "Track actionlint version pinned in CI install script",
            "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
            "matchStrings": ["actionlint[/-](?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "rhysd/actionlint"
        },
        {
            "customType": "regex",
            "description": "Track firebase-tools version pinned via `npm install -g firebase-tools@<ver>` in workflow shell steps",
            "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
            "matchStrings": ["firebase-tools@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            "datasourceTemplate": "npm",
            "depNameTemplate": "firebase-tools"
        },
        {
            "customType": "regex",
            "description": "Track Terraform version pinned in setup-terraform workflow inputs (keep in sync with .terraform-version)",
            "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
            "matchStrings": [
                "terraform_version:\\s*['\"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)['\"]?"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "hashicorp/terraform",
            "extractVersionTemplate": "^v(?<version>.+)$",
            "versioningTemplate": "hashicorp"
        }
    ]
}
