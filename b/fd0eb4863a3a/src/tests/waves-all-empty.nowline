nowline v1

// Wave fixture: waves are declared but no item, group or parallel is
// assigned to any of them. The wave strip draws only the muted italic
// placeholder (specs/waves.md §9.1), with no boundaries, markers or
// crossings; the legend reads "(no items)" for every wave. The long wave
// title widens the placeholder. Every item has no wave:, so it draws
// hatched as background work and the legend shows the background entry.

roadmap waves-all-empty "All waves empty" start:2026-01-05 scale:1w

wave discover "Discover"
wave build "Build and harden the platform for general availability"
wave launch "Launch"

swimlane a "Lane A"
  item a1 "Item A1" duration:2w
  item a2 "Item A2" duration:1w

swimlane b "Lane B"
  item b1 "Item B1" duration:3w
