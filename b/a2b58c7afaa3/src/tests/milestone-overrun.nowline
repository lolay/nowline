nowline v1

// A dated milestone overrun by an item: Polish ends four weeks past Ship's
// date, so Ship slips. Its diamond on the date renders red, a red dotted
// span runs along its row to a normal diamond at Polish's end, and the
// label and cut line sit there. UI finishes before Ship and changes
// nothing. Review's predecessor ends on time, so Review stays in ink.

roadmap milestone-overrun "Milestone overrun" start:2026-01-05 scale:1w

swimlane core "Core"
  item build "Build" duration:6w
  item polish "Polish" duration:3w after:build

swimlane web "Web"
  item ui "UI" duration:3w

milestone review "Review" date:2026-02-23 after:build
milestone ship "Ship" date:2026-02-02 after:[polish, ui]
