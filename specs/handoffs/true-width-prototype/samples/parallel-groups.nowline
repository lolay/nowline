nowline v1

roadmap r "Parallel of 1d groups" start:2026-01-05 scale:1w

swimlane s "Sprint"
  parallel p
    group g1 "Two days"
      item a1 "A1" duration:1d
      item a2 "A2" duration:1d
    group g2 "Four days"
      item b1 "B1" duration:1d
      item b2 "B2" duration:1d
      item b3 "B3" duration:1d
      item b4 "B4" duration:1d
  item z "After" duration:1d

milestone m "Done" after:z
