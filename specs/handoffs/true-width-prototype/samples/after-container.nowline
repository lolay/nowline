nowline v1

roadmap r "After a parallel or a group" start:2026-01-05 calendar:full scale:1w

swimlane build "Build"
  parallel p
    item api "API" duration:2w
    item sdk "SDK" duration:4w
  group g "Hardening"
    item perf "Perf" duration:1w
    item docs "Write the onboarding guide and every settings page reference" duration:1d

swimlane ship "Ship"
  item z1 "After P" duration:1w after:p

swimlane launch "Launch"
  item z2 "After G" duration:1w after:g

milestone m "Done" after:g
